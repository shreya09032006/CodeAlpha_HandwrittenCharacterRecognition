PORT=5000
# Comma-separated list of frontends allowed to call this API
CORS_ORIGINS=http://localhost:5173
# Where the trained letter model lives (default shown)
MODEL_PATH=models/emnist_cnn.keras

# Essay correction (get free keys from Google AI Studio and Groq). Leave blank to skip correction.
LLM_API_KEY=
GROQ_API_KEY=
LLM_ORDER=gemini,groq
LLM_TIMEOUT=40
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# History and Insights storage (default: backend/data/inklens.db)
# DB_PATH=data/inklens.db
# Only if the site uses Supabase sign-in; same public values as the frontend
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
